<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves this app in a backup: the replica holds plaintext and the key
     record would be restored onto a device that never unlocked it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
